@@ -411,12 +411,36 @@ from .queue_delay import on_video_job_start
 arq_resilience.install()
 
 
+# Video jobs running in this process; when the last one ends, cached Whisper models are released.
+_ACTIVE_VIDEO_JOBS = 0
+
+
 async def on_video_job_begin(ctx) -> None:
+    global _ACTIVE_VIDEO_JOBS
+    _ACTIVE_VIDEO_JOBS += 1
     await on_video_job_start(ctx)
     # Lets the render autoscaler see that this machine is busy (host_jobs.py).
     await host_jobs.record_job_start(ctx)
 
 
+async def on_video_job_end(ctx) -> None:
+    global _ACTIVE_VIDEO_JOBS
+    _ACTIVE_VIDEO_JOBS = max(0, _ACTIVE_VIDEO_JOBS - 1)
+    try:
+        await host_jobs.record_job_end(ctx)
+    finally:
+        if _ACTIVE_VIDEO_JOBS == 0:
+            # An idle worker must not keep Whisper (edge listening, transcription) in VRAM that the
+            # local LLM needs (media/transcription.py: whisper_release_enabled).
+            try:
+                from ..media.transcription import release_whisper_models, whisper_release_enabled
+
+                if whisper_release_enabled():
+                    release_whisper_models()
+            except Exception as exc:  # noqa: BLE001 - never fail a job over freeing memory
+                logger.warning("Could not release Whisper models: %s", exc)
+
+
 # Worker configuration for arq
