     return _WHISPER_MODEL_CACHE[model_name]
 
 
+def whisper_release_enabled() -> bool:
+    """Whether Whisper models give their GPU memory back when not in use (WHISPER_RELEASE_GPU, default on).
+
+    The worker shares one GPU with a local LLM (Ollama). A cached model keeps 1-3 GB of VRAM that the
+    LLM needs during the analysis; on Windows/WSL the driver then pages the LLM out to system memory and
+    it slows down tenfold. Reloading a model from the local cache costs a few seconds.
+    """
+    import os
+
+    return (os.getenv("WHISPER_RELEASE_GPU") or "true").strip().lower() not in ("0", "false", "no", "off")
+
+
+def release_whisper_models(model_names: Optional[List[str]] = None) -> List[str]:
+    """Drop cached Whisper models (all when ``model_names`` is None) and free their GPU memory.
+
+    Safe while another job still transcribes: it keeps its own reference until it is done, and the
+    next caller loads the model again.
+    """
+    names = [name for name in (model_names if model_names is not None else list(_WHISPER_MODEL_CACHE))
+             if name in _WHISPER_MODEL_CACHE]
+    for name in names:
+        _WHISPER_MODEL_CACHE.pop(name, None)
+    if names:
+        import gc
+
+        gc.collect()
+        try:
+            import torch
+
+            if torch.cuda.is_available():
+                torch.cuda.empty_cache()
+        except Exception:  # noqa: BLE001 - freeing memory is best effort
+            pass
+        logger.info("Released Whisper model(s) from memory: %s", ", ".join(names))
+    return names
+
+
 def transcribe_with_whisper(
     video_path: Path, model_name: str = "base", language: Optional[str] = None
 ) -> Dict[str, Any]:
@@ -878,9 +915,14 @@ def _get_transcript_with_whisper(video_path: Path, runtime_config) -> str:
     """Get transcript using local Whisper with word-level timestamps."""
     model_name = runtime_config.whisper_model
     logger.info("Starting Whisper transcription with model: %s", model_name)
-    whisper_result = transcribe_with_whisper(
-        video_path, model_name, runtime_config.transcription_language or None
-    )
+    try:
+        whisper_result = transcribe_with_whisper(
+            video_path, model_name, runtime_config.transcription_language or None
+        )
+    finally:
+        # The analysis that follows runs on the local LLM, which needs this VRAM.
+        if whisper_release_enabled():
+            release_whisper_models([model_name])
 
     formatted_lines = format_transcript_for_analysis(whisper_result)
     cache_transcript_data(video_path, whisper_result)
diff --git a/backend/src/workers/tasks.py b/backend/src/workers/tasks.py
